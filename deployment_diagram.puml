@startuml

!theme plain

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam roundcorner 0

title Deployment Diagram - Smart City Management System

'================ CLIENT DEVICES ================

node "Citizen Device" as citizen {
    artifact "Citizen Application\n- Login\n- Submit Complaint\n- Track Complaint\n- View Services"
}

node "Admin Device" as admin {
    artifact "Admin Application\n- Manage Users\n- Review Complaints\n- Assign Department\n- Generate Reports"
}

node "Service Department Device" as department {
    artifact "Department Application\n- View Complaints\n- Process Complaint\n- Resolve Complaint\n- Update Status"
}

node "Traffic Officer Device" as officer {
    artifact "Traffic Application\n- View Traffic Data\n- Update Traffic Status\n- Manage Traffic Records"
}

'================ APPLICATION SERVER ================

node "Application Server" as appServer {
    
    component "Authentication Service" as auth
    
    component "Complaint Management" as complaint
    
    component "Service Management" as service
    
    component "Notification Service" as notification
    
}

'================ DATABASE ================

database "Database Server" as db {
    artifact "Smart City Database\n\n- Users\n- Complaints\n- Service Requests\n- Property Tax\n- Payments\n- Notifications\n- Traffic Records"
}

'================ TRAFFIC ================

node "Traffic Sensors" as sensors {
    artifact "Traffic Data"
}

'================ CONNECTIONS ================

citizen --> appServer
admin --> appServer
department --> appServer
officer --> appServer

sensors --> appServer

appServer --> db

@enduml